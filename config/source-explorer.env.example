# TorqMind Xpert Source Explorer — SQL Server connection
# Copy to config/source-explorer.env and fill in real values.
# NEVER commit source-explorer.env to Git.

SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_HOST=CHANGE_ME
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CHANGE_ME
SQLSERVER_USER=CHANGE_ME
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_CERT=yes
SQLSERVER_TIMEOUT_SECONDS=20

# Optional: PostgreSQL STG for compare-stg commands
# Falls back to main TorqMind env (POSTGRES_HOST, etc.) if omitted.
# STG_PG_HOST=CHANGE_ME
# STG_PG_PORT=5432
# STG_PG_DATABASE=CHANGE_ME
# STG_PG_USER=CHANGE_ME
# STG_PG_PASSWORD=CHANGE_ME
