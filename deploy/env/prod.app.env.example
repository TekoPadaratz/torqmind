APP_ENV=prod
APP_ROOT_PATH=

PG_HOST=IP_PRIVADO_POSTGRES
PG_PORT=5432
POSTGRES_DB=TORQMIND
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@IP_PRIVADO_POSTGRES:5432/TORQMIND

CLICKHOUSE_HOST=IP_PRIVADO_ANALYTICS
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=torqmind_mart
CLICKHOUSE_USER=torqmind
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CLICKHOUSE_PASSWORD
USE_CLICKHOUSE=true
DUAL_READ_MODE=false
USE_REALTIME_MARTS=false
REALTIME_MARTS_SOURCE=stg
REALTIME_MARTS_DOMAINS=dashboard,sales,cash,fraud,finance,payments
REALTIME_MARTS_FALLBACK=false
REFRESH_LEGACY_PG_MARTS=false

API_JWT_SECRET=CHANGE_ME_STRONG_API_JWT_SECRET_AT_LEAST_32_CHARS
API_JWT_ISSUER=torqmind-api
API_ACCESS_TOKEN_MINUTES=60
INGEST_REQUIRE_KEY=true
INGEST_BATCH_SIZE=5000
INGEST_RETENTION_OVERRIDE_MIN_DATE=
INGEST_RETENTION_OVERRIDE_DATASETS=comprovantes,movprodutos,itensmovprodutos,formas_pgto_comprovantes,turnos
ETL_INTERNAL_KEY=CHANGE_ME_STRONG_ETL_INTERNAL_KEY

APP_CORS_ORIGINS=
APP_CORS_ORIGIN_REGEX=
DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_MAX_IDLE_SECONDS=300
BUSINESS_TIMEZONE=America/Sao_Paulo
BUSINESS_TENANT_TIMEZONES=

SEED_PASSWORD=CHANGE_ME_STRONG_SEED_PASSWORD
PLATFORM_MASTER_EMAIL=CHANGE_ME_PLATFORM_MASTER_EMAIL
PLATFORM_MASTER_PASSWORD=CHANGE_ME_STRONG_PLATFORM_MASTER_PASSWORD
PLATFORM_MASTER_NAME="TorqMind Platform Master"
CHANNEL_BOOTSTRAP_EMAIL=CHANGE_ME_CHANNEL_BOOTSTRAP_EMAIL
CHANNEL_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_CHANNEL_BOOTSTRAP_PASSWORD
CHANNEL_BOOTSTRAP_USER_NAME="TorqMind Channel Admin"
CHANNEL_BOOTSTRAP_NAME="Canal TorqMind"

NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_BUSINESS_TIMEZONE=America/Sao_Paulo
NGINX_HTTP_BIND_IP=0.0.0.0
NGINX_HTTP_PORT=80

OPERATIONAL_INTERVAL_MINUTES=2
RISK_INTERVAL_MINUTES=30
PIPELINE_TIMEOUT_SECONDS=90
PIPELINE_WARN_SECONDS=30
PIPELINE_TRACK_LOG_MAX_BYTES=12000
REFRESH_LEGACY_PG_MARTS=false
CLICKHOUSE_INCREMENTAL_ENABLED=true

TELEGRAM_BOT_TOKEN=
NOTIFY_MIN_SEVERITY=CRITICAL
OPENAI_API_KEY=
JARVIS_MODEL_FAST=gpt-4.1-mini
JARVIS_MODEL_STRONG=gpt-4.1
JARVIS_AI_TOP_N=10
JARVIS_AI_MAX_OUTPUT_TOKENS=500
JARVIS_AI_TIMEOUT_SECONDS=30
JARVIS_AI_RPM_SLEEP_SECONDS=2
JARVIS_AI_INPUT_COST_PER_1M=0.4
JARVIS_AI_OUTPUT_COST_PER_1M=1.6

# Recuperação de senha + SMTP transacional (env-driven; nomes reais do config.py).
# SMTP_ENABLED=false (padrão) => envio é no-op seguro. NÃO use remetente em domínio
# não controlado (ex.: @torqmind.com). Configure SPF/DKIM/DMARC antes de domínio próprio.
WEB_PUBLIC_URL=http://SEU_HOST_PUBLICO
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_LINK_PATH=/reset-password
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM=
SMTP_FROM_NAME=TorqMind
SMTP_TIMEOUT_SECONDS=20

# 2FA / autenticação em dois fatores (TOTP).
# TOTP_ENCRYPTION_KEY: chave Fernet base64 (32 bytes) que cifra o segredo em repouso.
# Vazio => 2FA indisponível (setup retorna 503). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA commitar a chave real; só em /etc/torqmind/prod.app.env (mode 600).
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=TorqMind
TOTP_VALID_WINDOW=1
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5

